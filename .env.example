DATABASE_URL=sqlite:///data/pitchrank.sqlite3
PITCHRANK_SEASON=2026-2027
SQUAD_LOG_SCALE=60
SQUAD_RATING_CAP=100
# Export these in your shell. The app does not load .env automatically.
# If needed on macOS: SSL_CERT_FILE=/etc/ssl/cert.pem

# One fixed squad-value reference for every league. Recalculate both leagues after changing it.
SQUAD_REFERENCE_EUR=556425000

# Unified replay: weights are initial assumptions, not optimized coefficients.
ELO_HISTORY_START=2024-2025
ELO_DOMESTIC_IMPORTANCE=1.0
ELO_UCL_LEAGUE_IMPORTANCE=1.25
ELO_UCL_KNOCKOUT_IMPORTANCE=1.5
ELO_UCL_FINALS_IMPORTANCE=1.75
